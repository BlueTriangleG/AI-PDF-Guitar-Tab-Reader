{
  "name": "ai-guitar-reader",
  "version": "0.1.0",
  "description": "macOS Electron PDF gallery and reader for guitar scores",
  "main": "src/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:renderer": "vite build",
    "build:pdfkit": "bash scripts/build-pdfkit-cli.sh",
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "postinstall": "bash scripts/copy-pdfjs-assets.sh",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "build": "npm run build:renderer && npm run build:pdfkit",
    "pack:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "pdfjs-dist": "^5.4.530",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.autumn.aiguitarreader",
    "productName": "AI Guitar Reader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/application/**/*",
      "src/domain/**/*",
      "src/infrastructure/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/infrastructure/pdf/pdfkit-cli/bin",
        "to": "pdfkit-cli"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "assets/app-icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlementsInherit": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "AI Guitar Reader needs microphone access to tune your guitar and record audio.",
        "NSCameraUsageDescription": "AI Guitar Reader needs camera access to record video sessions."
      }
    },
    "dmg": {
      "artifactName": "AI-Guitar-Reader.dmg"
    }
  }
}
